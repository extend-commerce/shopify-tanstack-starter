# Local Postgres session store (ADR 0005). Matches the root docker-compose.yml
# `postgres` service. `pnpm db:up` brings the DB up, migrates, and seeds.
DATABASE_URL=postgres://shopify:shopify@localhost:5432/shopify_tanstack_starter

# WS5 (ADR 0008 / ENG-2332) appends the Shopify vars here:
# SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SCOPES, ...
