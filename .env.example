# Copy to `.env` at the REPO ROOT (next to shopify.app.toml). One env file for the
# whole monorepo — this is where `shopify app env pull` writes, where Vite reads
# it (forwarded to process.env in apps/web/vite.config.ts), and where
# drizzle-kit / `db:seed` / `start` load it from.

# Local SQLite session store (ADR 0012 / 0017). Path is relative to apps/web
# (where drizzle-kit and the Vite app run). `pnpm db:up` creates `.data/` at the
# repo root, migrates, and seeds. NOT injected by the Shopify CLI — this is the
# one var that always comes from `.env`.
DATABASE_URL=file:../../.data/dev.sqlite

# Shopify app credentials (ADR 0008). `shopify app dev` injects these into the
# process automatically; they are only needed for a bare `pnpm --filter web dev`
# or `pnpm --filter web start` without the CLI (or run `shopify app env pull`).
# Server-only — there is NO VITE_-prefixed public mirror; the public API key
# reaches __root via a server-only read of SHOPIFY_API_KEY.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products

# Public app URL / host. `shopify app dev` sets HOST to the tunnel URL.
# HOST=https://your-tunnel.trycloudflare.com
