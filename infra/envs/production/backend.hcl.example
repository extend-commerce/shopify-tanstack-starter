# R2 (S3-compatible) Terraform state backend (ADR 0015).
# Create the bucket out of band first (shared with staging, different key):
#   wrangler r2 bucket create shopify-tanstack-starter-tfstate
#
# terraform init -backend-config=backend.hcl
#
# Rename this file to backend.hcl and fill in account_id + bucket.

bucket = "shopify-tanstack-starter-tfstate"
key    = "shopify-tanstack-starter/production/terraform.tfstate"
region = "auto"

use_lockfile                = true
use_path_style              = true
skip_s3_checksum            = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_requesting_account_id  = true
skip_region_validation      = true

endpoints = {
  s3 = "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
}
