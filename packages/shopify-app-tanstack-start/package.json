{
  "name": "shopify-app-tanstack-start",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Framework glue that gives a TanStack Start app the Shopify capabilities @shopify/shopify-app-react-router gives a React Router app. Consumed as TypeScript source (JIT, ssr.noExternal). Not published. See docs/adr/0001.",
  "//adapters": "Runtime adapters live in the app (`apps/web/app/platform*.ts`), which imports `@shopify/shopify-api/adapters/<runtime>` directly. The package stays runtime-agnostic (amends ADR 0009).",
  "exports": {
    ".": "./src/server/index.ts",
    "./react": "./src/react/index.ts",
    "./middleware": "./src/middleware/index.ts",
    "./webhooks": "./src/webhooks/index.ts",
    "./clients": "./src/clients/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format:check": "prettier --check src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@shopify/admin-api-client": "catalog:",
    "@shopify/shopify-api": "catalog:",
    "@shopify/shopify-app-session-storage": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shopify/admin-api-client": "catalog:",
    "@shopify/shopify-api": "catalog:",
    "@shopify/shopify-app-session-storage": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "5.0.0"
  }
}
